---
/**
 * Home for everything demoted out of primary nav: notes, tags, start,
 * journey, contact, work. Reachable and linkable — just not competing for a
 * first-time reader's attention.
 *
 * (Replaces the unused Astro-template scaffold that read "© Your name here"
 *  and linked to Astro's own social accounts. It was never rendered.)
 */
import { getCollection } from 'astro:content';

const today = new Date();
const projects = await getCollection('projects');
const hasProjects = projects.length > 0;

const columns = [
  {
    title: 'Writing',
    links: [
      { label: 'Essays', href: '/blog' },
      { label: 'Notes', href: '/notes' },
      { label: 'Tags', href: '/tags' },
      { label: 'Start here', href: '/start' },
      { label: 'RSS', href: '/rss.xml' },
    ],
  },
  {
    title: 'Building',
    links: [
      ...(hasProjects ? [{ label: 'Projects', href: '/projects' }] : []),
    ],
  },
  {
    title: 'About',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Journey', href: '/journey' },
      { label: 'Work with me', href: '/work' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];
---

<footer class="max-w-7xl mx-auto px-4 pb-16 pt-8 mt-16 border-t border-gray-200 dark:border-gray-800">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">
    <div class="col-span-2 md:col-span-1">
      <p class="font-mono font-bold mb-2">rwolfe.io</p>
      <p class="text-gray-500 dark:text-gray-400 leading-relaxed max-w-xs">
        Notes on building systems — and the people who build them.
      </p>
    </div>

    {columns.filter((col) => col.links.length > 0).map((col) => (
      <div>
        <h2 class="font-semibold mb-3 text-gray-900 dark:text-gray-100">{col.title}</h2>
        <ul class="space-y-2">
          {col.links.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-gray-500 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <p class="text-xs text-gray-400 dark:text-gray-600 mt-10">
    &copy; {today.getFullYear()} Ryan Wolfe
  </p>
</footer>
