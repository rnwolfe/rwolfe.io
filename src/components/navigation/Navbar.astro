---
import { Icon } from 'astro-icon/components';
import ThemeToggle from '../ui/ThemeToggle.astro';

import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const hasProjects = projects.length > 0;

const navItems = [
  { label: 'Home', href: '/' },
  {
    label: 'Writing',
    href: '/start',
    children: [
      { label: 'Start', href: '/start' },
      { label: 'Blog', href: '/blog' },
      { label: 'Notes', href: '/notes' },
      { label: 'Tags', href: '/tags' },
    ],
  },
  {
    label: 'About',
    href: '/about',
    children: [
      { label: 'Journey', href: '/journey' },
      { label: 'About', href: '/about' },
      { label: 'Uses', href: '/uses' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  ...(hasProjects ? [{ label: 'Selected Work', href: '/projects' }] : []),
];
---

<nav class="glass-panel !overflow-visible p-4 mb-6 md:mb-12 flex justify-between items-center sticky top-4 z-50 rounded-2xl">
  <a href="/" class="text-xl font-bold font-mono flex items-center gap-2 hover:text-brand-600 transition-colors group">
    <Icon name="lucide:terminal" class="w-6 h-6 text-brand-500 group-hover:rotate-12 transition-transform" />
    <span id="logo-text" data-value="rwolfe.io">rwolfe.io</span>
  </a>

  <div class="flex items-center gap-6">
    <div class="hidden md:flex items-center gap-6 text-sm font-medium">
      {navItems.map((item) => (
        item.children ? (
          <div class="group relative">
            <a 
              href={item.href} 
              class="flex items-center gap-1 hover:text-brand-500 transition-colors py-2"
            >
              {item.label}
              <Icon name="lucide:chevron-down" class="w-3 h-3 opacity-50 group-hover:rotate-180 transition-transform duration-200" />
            </a>
            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible translate-y-1 group-hover:translate-y-0 transition-all duration-200 pointer-events-none group-hover:pointer-events-auto z-[100]">
              <div class="bg-white/90 dark:bg-neutral-900/90 backdrop-blur-xl rounded-xl p-2 min-w-[140px] shadow-lg border border-black/5 dark:border-white/10">
                {item.children.map((child) => (
                  <a 
                    href={child.href}
                    class="block px-3 py-2 rounded-lg hover:bg-brand-500/10 hover:text-brand-500 transition-colors text-sm"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class="hover:text-brand-500 transition-colors py-2">
            {item.label}
          </a>
        )
      ))}
    </div>
    
    <!-- Mobile menu button -->
    <button 
      id="mobile-menu-btn" 
      class="md:hidden p-2 hover:text-brand-500 transition-colors"
      aria-label="Toggle menu"
    >
      <Icon name="lucide:menu" class="w-5 h-5" />
    </button>
    
    <ThemeToggle />
  </div>
</nav>

<!-- Mobile menu -->
<div id="mobile-menu" class="md:hidden fixed inset-x-4 top-20 z-40 glass-panel rounded-2xl p-4 opacity-0 invisible translate-y-2 transition-all duration-200">
  {navItems.map((item) => (
    <div class="mobile-nav-group">
      <a href={item.href} class="block py-2 font-medium hover:text-brand-500 transition-colors">
        {item.label}
      </a>
      {item.children && (
        <div class="pl-4 border-l border-white/10 ml-2 mb-2">
          {item.children.map((child) => (
            <a 
              href={child.href}
              class="block py-1.5 text-sm text-gray-600 dark:text-gray-400 hover:text-brand-500 transition-colors"
            >
              {child.label}
            </a>
          ))}
        </div>
      )}
    </div>
  ))}
</div>

<style>
  /* Mobile menu open state */
  #mobile-menu.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>

<script>
  const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';

  const initNavbar = () => {
    // Logo scramble effect
    const element = document.getElementById('logo-text') as HTMLElement | null;
    if (element) {
      let intervalId: ReturnType<typeof setInterval> | null = null;

      element.onmouseover = () => {
        let iteration = 0;
        const originalValue = element.dataset.value || '';

        if (intervalId) clearInterval(intervalId);

        intervalId = setInterval(() => {
          element.innerText = originalValue
            .split('')
            .map((letter: string, index: number) => {
              if (index < iteration) return originalValue[index];
              return letters[Math.floor(Math.random() * letters.length)];
            })
            .join('');

          if (iteration >= originalValue.length) {
            if (intervalId) clearInterval(intervalId);
          }
          iteration += 1 / 3;
        }, 30);
      };
    }

    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('open');
      });

      // Close menu when clicking outside
      document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target as Node) && !mobileMenuBtn.contains(e.target as Node)) {
          mobileMenu.classList.remove('open');
        }
      });

      // Close menu on navigation
      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.remove('open');
        });
      });
    }
  };

  // Works both with and without Astro View Transitions
  document.addEventListener('DOMContentLoaded', initNavbar);
  document.addEventListener('astro:page-load', initNavbar);
</script>
