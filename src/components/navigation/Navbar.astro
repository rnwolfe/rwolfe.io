---
import { Icon } from 'astro-icon/components';
import ThemeToggle from '../ui/ThemeToggle.astro';

import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const hasProjects = projects.length > 0;

// Flat, three-item nav. Two dropdowns with eight sub-items were browsing
// surfaces competing for a first-time reader's attention; they now live in the
// footer, reachable but not shouting. The split is deliberate:
//   Essays  → the people side
//   Projects → the systems side (only shown once there's something to show)
const navItems = [
  { label: 'Essays', href: '/blog' },
  ...(hasProjects ? [{ label: 'Projects', href: '/projects' }] : []),
  { label: 'About', href: '/about' },
];
---

<nav class="glass-panel !overflow-visible relative isolate p-4 mb-6 md:mb-12 flex justify-between items-center sticky top-4 z-50 rounded-2xl">
  <a href="/" class="text-xl font-bold font-mono flex items-center gap-2 hover:text-brand-600 transition-colors group">
    <Icon name="lucide:terminal" class="w-6 h-6 text-brand-500 group-hover:rotate-12 transition-transform" />
    <span id="logo-text" data-value="rwolfe.io">rwolfe.io</span>
  </a>

  <div class="flex items-center gap-6">
    <div class="hidden md:flex items-center gap-6 text-sm font-medium">
      {navItems.map((item) => (
        <a href={item.href} class="hover:text-brand-500 transition-colors py-2">
          {item.label}
        </a>
      ))}
    </div>
    
    <!-- Mobile menu button -->
    <button 
      id="mobile-menu-btn" 
      class="md:hidden p-2 hover:text-brand-500 transition-colors"
      aria-label="Toggle menu"
    >
      <Icon name="lucide:menu" class="w-5 h-5" />
    </button>
    
    <ThemeToggle />
  </div>
</nav>

<!-- Mobile menu -->
<div id="mobile-menu" class="md:hidden fixed inset-x-4 top-20 z-40 glass-panel rounded-2xl p-4 opacity-0 invisible translate-y-2 transition-all duration-200">
  {navItems.map((item) => (
    <a href={item.href} class="block py-2 font-medium hover:text-brand-500 transition-colors">
      {item.label}
    </a>
  ))}
</div>

<style>
  /* Mobile menu open state */
  #mobile-menu.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>

<script>
  const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';

  let documentClickBound = false;

  const initNavbar = () => {
    // Logo scramble effect
    const element = document.getElementById('logo-text') as HTMLElement | null;
    if (element) {
      let intervalId: ReturnType<typeof setInterval> | null = null;

      element.onmouseover = () => {
        let iteration = 0;
        const originalValue = element.dataset.value || '';

        if (intervalId) clearInterval(intervalId);

        intervalId = setInterval(() => {
          element.innerText = originalValue
            .split('')
            .map((_letter: string, index: number) => {
              if (index < iteration) return originalValue[index];
              return letters[Math.floor(Math.random() * letters.length)];
            })
            .join('');

          if (iteration >= originalValue.length) {
            if (intervalId) clearInterval(intervalId);
          }
          iteration += 1 / 3;
        }, 30);
      };
    }

    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    // Both DOMContentLoaded and astro:page-load fire on the *initial* load when
    // ClientRouter is active. Binding twice made every click toggle `open` twice,
    // so the button did nothing. Bind once per element; view transitions swap in
    // fresh nodes each navigation, which resets the flag and rebinds.
    if (mobileMenuBtn && mobileMenu && !mobileMenuBtn.dataset.bound) {
      mobileMenuBtn.dataset.bound = 'true';

      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('open');
      });

      // Close menu on navigation
      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.remove('open');
        });
      });
    }

    // Close menu when clicking outside. `document` survives view transitions, so
    // this is registered once for the lifetime of the tab and re-resolves the
    // current nodes on each event rather than closing over stale ones.
    if (!documentClickBound) {
      documentClickBound = true;
      document.addEventListener('click', (e) => {
        const menu = document.getElementById('mobile-menu');
        const btn = document.getElementById('mobile-menu-btn');
        if (!menu || !btn) return;
        if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
          menu.classList.remove('open');
        }
      });
    }
  };

  // Works both with and without Astro View Transitions
  document.addEventListener('DOMContentLoaded', initNavbar);
  document.addEventListener('astro:page-load', initNavbar);
</script>
