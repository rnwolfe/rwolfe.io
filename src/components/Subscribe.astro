---
/**
 * Email capture — Buttondown embed, no API key, no backend.
 *
 * HOW IT WORKS. The form is a real `<form action method="post">` pointed at
 * Buttondown's embed endpoint, so it works with JavaScript disabled (the
 * visitor is taken to Buttondown's own confirmation page). JS then
 * progressively enhances it: the submit is intercepted and re-sent with
 * `fetch(..., { mode: 'no-cors' })` so the reader stays on the page.
 *
 * THE HONEST CAVEAT. `no-cors` makes the response opaque — we cannot read the
 * status, so the inline success message is *optimistic*. That's acceptable
 * here only because Buttondown is double opt-in: nobody is subscribed until
 * they click the link in the confirmation email, so "check your inbox to
 * confirm" is true whether or not the POST succeeded. Client-side validation
 * catches the common failure (a malformed address) before we get there.
 *
 * If precise success/failure ever matters more than simplicity, put a
 * serverless function in front of Buttondown's authenticated API and point
 * PUBLIC_NEWSLETTER_ACTION at it — the markup below doesn't change.
 */
interface Props {
  /** 'panel' = standalone card (homepage). 'inline' = end-of-essay. */
  variant?: 'panel' | 'inline';
  heading?: string;
  blurb?: string;
  class?: string;
}

const {
  variant = 'panel',
  heading = 'New essays, when they’re worth sending',
  blurb = 'Occasional writing on building systems — and the people who build them. No cadence promises, no filler. Unsubscribe in one click.',
  class: className = '',
} = Astro.props;

// Set PUBLIC_NEWSLETTER_ACTION to '' to deliberately render the disabled state.
const action =
  import.meta.env.PUBLIC_NEWSLETTER_ACTION ??
  'https://buttondown.com/api/emails/embed-subscribe/rwolfe.io';
const configured = action.length > 0;
const id = `sub-${Math.random().toString(36).slice(2, 8)}`;
---

<section
  class:list={[
    'subscribe',
    variant === 'inline'
      ? 'mt-12 pt-8 border-t border-gray-200 dark:border-gray-700'
      : '',
    className,
  ]}
  aria-labelledby={`${id}-h`}
>
  <h2
    id={`${id}-h`}
    class:list={[
      'font-bold tracking-tight',
      variant === 'inline' ? 'text-xl mb-2' : 'text-2xl mb-2',
    ]}
  >
    {heading}
  </h2>
  <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed max-w-prose mb-5">
    {blurb}
  </p>

  <form
    class="sub-form embeddable-buttondown-form flex flex-col sm:flex-row gap-3 max-w-md"
    action={action}
    method="post"
    target="_blank"
  >
    <label class="sr-only" for={`${id}-email`}>Email address</label>
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      disabled={!configured}
      class="flex-1 min-w-0 px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white/70 dark:bg-neutral-900/70 text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500/60 focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed"
    />
    <button
      type="submit"
      disabled={!configured}
      class="px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-xl font-medium hover:opacity-90 transition-opacity disabled:opacity-40 disabled:cursor-not-allowed whitespace-nowrap"
    >
      Subscribe
    </button>
  </form>

  <p class="sub-status text-sm mt-3 min-h-[1.25rem]" role="status" aria-live="polite">
    {!configured && (
      <span class="text-gray-500 dark:text-gray-500">
        Signup opens shortly — the list isn’t wired up yet.
      </span>
    )}
  </p>

  <p class="text-xs text-gray-400 dark:text-gray-600 mt-2">
    <a
      href="https://buttondown.com/refer/rwolfe.io"
      target="_blank"
      rel="noopener"
      class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
    >
      Powered by Buttondown.
    </a>
  </p>
</section>

<script>
  const init = () => {
    document.querySelectorAll<HTMLElement>('.subscribe').forEach((root) => {
      if (root.dataset.bound === '1') return;

      const form = root.querySelector<HTMLFormElement>('.sub-form');
      const status = root.querySelector<HTMLElement>('.sub-status');
      const input = root.querySelector<HTMLInputElement>('input[type="email"]');
      const button = root.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!form || !status || !input || !button) return;
      if (!form.action) return;

      root.dataset.bound = '1';
      // Only stop the native navigation once JS is definitely handling it.
      form.removeAttribute('target');

      const say = (msg: string, tone: 'ok' | 'err' | 'muted') => {
        status.textContent = msg;
        status.className =
          'sub-status text-sm mt-3 min-h-[1.25rem] ' +
          (tone === 'ok'
            ? 'text-green-600 dark:text-green-400'
            : tone === 'err'
              ? 'text-red-600 dark:text-red-400'
              : 'text-gray-500');
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = input.value.trim();
        if (!email || !input.checkValidity()) {
          say('That email doesn’t look right.', 'err');
          input.focus();
          return;
        }

        button.disabled = true;
        say('Subscribing…', 'muted');

        try {
          // Opaque by design — see the component comment. Buttondown's embed
          // endpoint sends no CORS headers, so we can't read the result.
          await fetch(form.action, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'content-type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ email }).toString(),
          });
          form.reset();
          say('Almost there — check your inbox to confirm.', 'ok');
        } catch {
          // Network-level failure. Fall back to the real form post so the
          // visitor still gets subscribed rather than hitting a dead end.
          say('Opening the signup page…', 'muted');
          form.setAttribute('target', '_blank');
          form.submit();
        } finally {
          button.disabled = false;
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>
