---
/**
 * Email capture.
 *
 * CONTRACT — this component is not provider-agnostic by itself. It POSTs
 * `{"email": "..."}` as JSON and expects a 2xx for success; anything else is
 * treated as failure. That means the endpoint must accept a cross-origin JSON
 * POST, which most provider APIs do NOT (they require an API key, which a
 * static site cannot hold safely).
 *
 * So the default endpoint is our own `/api/subscribe` serverless function,
 * which speaks this contract and holds the provider key server-side. Swapping
 * providers (Buttondown, Resend, ...) is an env change in that function, not a
 * change here — that's where the reversibility actually lives.
 *
 * Override with PUBLIC_NEWSLETTER_ENDPOINT only for an endpoint that genuinely
 * accepts CORS JSON POSTs in this shape.
 *
 * With no endpoint configured the form renders in a clearly-labelled disabled
 * state rather than silently swallowing addresses.
 */
interface Props {
  /** 'panel' = standalone card (homepage). 'inline' = end-of-essay. */
  variant?: 'panel' | 'inline';
  heading?: string;
  blurb?: string;
  class?: string;
}

const {
  variant = 'panel',
  heading = 'New essays, when they’re worth sending',
  blurb = 'Occasional writing on building systems — and the people who build them. No cadence promises, no filler. Unsubscribe in one click.',
  class: className = '',
} = Astro.props;

// Defaults to our own function (see api/subscribe.ts). Set
// PUBLIC_NEWSLETTER_ENDPOINT to '' to deliberately render the disabled state.
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT ?? '/api/subscribe';
const configured = endpoint.length > 0;
const id = `sub-${Math.random().toString(36).slice(2, 8)}`;
---

<section
  class:list={[
    'subscribe',
    variant === 'inline'
      ? 'mt-12 pt-8 border-t border-gray-200 dark:border-gray-700'
      : '',
    className,
  ]}
  data-endpoint={endpoint}
  aria-labelledby={`${id}-h`}
>
  <h2
    id={`${id}-h`}
    class:list={[
      'font-bold tracking-tight',
      variant === 'inline' ? 'text-xl mb-2' : 'text-2xl mb-2',
    ]}
  >
    {heading}
  </h2>
  <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed max-w-prose mb-5">
    {blurb}
  </p>

  <form class="sub-form flex flex-col sm:flex-row gap-3 max-w-md" novalidate>
    <label class="sr-only" for={`${id}-email`}>Email address</label>
    <input
      id={`${id}-email`}
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      disabled={!configured}
      class="flex-1 min-w-0 px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white/70 dark:bg-neutral-900/70 text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500/60 focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed"
    />
    <button
      type="submit"
      disabled={!configured}
      class="px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-xl font-medium hover:opacity-90 transition-opacity disabled:opacity-40 disabled:cursor-not-allowed whitespace-nowrap"
    >
      Subscribe
    </button>
  </form>

  <p class="sub-status text-sm mt-3 min-h-[1.25rem]" role="status" aria-live="polite">
    {!configured && (
      <span class="text-gray-500 dark:text-gray-500">
        Signup opens shortly — the list isn’t wired up yet.
      </span>
    )}
  </p>
</section>

<script>
  const init = () => {
    document.querySelectorAll<HTMLElement>('.subscribe').forEach((root) => {
      if (root.dataset.bound === '1') return;
      const endpoint = root.dataset.endpoint || '';
      if (!endpoint) return;

      const form = root.querySelector<HTMLFormElement>('.sub-form');
      const status = root.querySelector<HTMLElement>('.sub-status');
      const input = root.querySelector<HTMLInputElement>('input[type="email"]');
      const button = root.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!form || !status || !input || !button) return;

      root.dataset.bound = '1';

      const say = (msg: string, tone: 'ok' | 'err' | 'muted') => {
        status.textContent = msg;
        status.className =
          'sub-status text-sm mt-3 min-h-[1.25rem] ' +
          (tone === 'ok'
            ? 'text-green-600 dark:text-green-400'
            : tone === 'err'
              ? 'text-red-600 dark:text-red-400'
              : 'text-gray-500');
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = input.value.trim();
        if (!email || !input.checkValidity()) {
          say('That email doesn’t look right.', 'err');
          input.focus();
          return;
        }

        button.disabled = true;
        say('Subscribing…', 'muted');

        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email }),
          });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          say('You’re in. Check your inbox to confirm.', 'ok');
        } catch {
          say('Something went wrong — try again in a moment.', 'err');
        } finally {
          // Always re-enable. Previously the success path left the button stuck
          // disabled until reload, which stranded anyone who mistyped their
          // address or hit a false-positive success.
          button.disabled = false;
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>
