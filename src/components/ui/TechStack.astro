---
interface Props {
  tech: string[];
  limit?: number;
  size?: 'sm' | 'md';
  class?: string;
}

const { tech, limit, size = 'sm', class: className } = Astro.props;

const displayedTech = limit ? tech.slice(0, limit) : tech;
const remainingCount = limit ? Math.max(0, tech.length - limit) : 0;

const sizeClasses = {
  sm: 'px-2 py-0.5 text-[10px] rounded-md',
  md: 'px-3 py-1 text-xs rounded-lg',
};
---

<div class:list={['flex flex-wrap gap-1.5', className]}>
  {displayedTech.map((item) => (
    <span class:list={[
      'bg-white/5 border border-white/10 text-zinc-300 font-mono backdrop-blur-sm transition-colors hover:bg-white/10 hover:border-white/20',
      sizeClasses[size]
    ]}>
      {item}
    </span>
  ))}
  
  {remainingCount > 0 && (
    <span class:list={[
      'bg-brand-500/10 border border-brand-500/20 text-brand-400 font-bold font-mono',
      sizeClasses[size]
    ]}>
      +{remainingCount}
    </span>
  )}
</div>
