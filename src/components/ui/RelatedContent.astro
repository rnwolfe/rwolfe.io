---
import { getEntries, type ReferenceDataEntry } from 'astro:content';
import GlassPanel from './GlassPanel.astro';

// These arrive straight from a `reference('…')` schema field, so they are already
// `{ collection, id }` pairs. Typing them as `any[]` gave `getEntries` nothing to
// infer its collection generic from, so it collapsed to `never[]` and every
// `.data` / `.id` access below was a type error.
interface Props {
	relatedProjects?: ReferenceDataEntry<'projects'>[];
	relatedDecisions?: ReferenceDataEntry<'decisions'>[];
	relatedPosts?: ReferenceDataEntry<'blog'>[];
	class?: string;
}

const { 
	relatedProjects = [], 
	relatedDecisions = [], 
	relatedPosts = [],
	class: className 
} = Astro.props;

// Resolve references to actual entries
const projects = relatedProjects.length ? await getEntries(relatedProjects) : [];
const decisions = relatedDecisions.length ? await getEntries(relatedDecisions) : [];
const posts = relatedPosts.length ? await getEntries(relatedPosts) : [];

const hasRelated = projects.length > 0 || decisions.length > 0 || posts.length > 0;
---

{hasRelated && (
	<aside class:list={['mt-12 pt-8 border-t border-gray-200 dark:border-gray-800', className]}>
		<h3 class="text-sm font-mono uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
			Related
		</h3>
		
		<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
			{projects.map((project) => (
				<a 
					href={`/projects/${project.id}`}
					class="group"
				>
					<GlassPanel class="p-4 h-full hover:border-brand-500/30 transition-colors">
						<div class="flex items-start gap-3">
							<div class="flex-shrink-0 w-8 h-8 rounded-lg bg-brand-500/10 flex items-center justify-center">
								<svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
								</svg>
							</div>
							<div class="min-w-0">
								<span class="text-xs font-mono uppercase tracking-wider text-gray-400 dark:text-gray-500">Project</span>
								<h4 class="font-medium text-sm group-hover:text-brand-500 transition-colors truncate">
									{project.data.title}
								</h4>
								{project.data.outcomeSummary && (
									<p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">
										{project.data.outcomeSummary}
									</p>
								)}
							</div>
						</div>
					</GlassPanel>
				</a>
			))}
			
			{decisions.map((decision) => (
				<a 
					href={`/decisions/${decision.id}`}
					class="group"
				>
					<GlassPanel class="p-4 h-full hover:border-purple-500/30 transition-colors">
						<div class="flex items-start gap-3">
							<div class="flex-shrink-0 w-8 h-8 rounded-lg bg-purple-500/10 flex items-center justify-center">
								<svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
							</div>
							<div class="min-w-0">
								<span class="text-xs font-mono uppercase tracking-wider text-gray-400 dark:text-gray-500">Decision</span>
								<h4 class="font-medium text-sm group-hover:text-purple-500 transition-colors truncate">
									{decision.data.title}
								</h4>
								<p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">
									{decision.data.decision}
								</p>
							</div>
						</div>
					</GlassPanel>
				</a>
			))}
			
			{posts.map((post) => (
				<a 
					href={`/blog/${post.id}`}
					class="group"
				>
					<GlassPanel class="p-4 h-full hover:border-emerald-500/30 transition-colors">
						<div class="flex items-start gap-3">
							<div class="flex-shrink-0 w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center">
								<svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
								</svg>
							</div>
							<div class="min-w-0">
								<span class="text-xs font-mono uppercase tracking-wider text-gray-400 dark:text-gray-500">Post</span>
								<h4 class="font-medium text-sm group-hover:text-emerald-500 transition-colors truncate">
									{post.data.title}
								</h4>
								{post.data.description && (
									<p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">
										{post.data.description}
									</p>
								)}
							</div>
						</div>
					</GlassPanel>
				</a>
			))}
		</div>
	</aside>
)}
