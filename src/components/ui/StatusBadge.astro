---
interface Props {
  status: 'draft' | 'ongoing' | 'completed' | 'archived' | 'featured' | 'proposed' | 'accepted' | 'deprecated' | 'superseded';
  class?: string;
}

const { status, class: className } = Astro.props;

const statusConfigs = {
  draft: {
    label: 'Draft',
    classes: 'bg-amber-400/10 text-amber-400 border-amber-400/20',
  },
  proposed: {
    label: 'Proposed',
    classes: 'bg-amber-400/10 text-amber-400 border-amber-400/20',
  },
  ongoing: {
    label: 'Ongoing',
    classes: 'bg-sky-400/10 text-sky-400 border-sky-400/20',
  },
  completed: {
    label: 'Completed',
    classes: 'bg-emerald-400/10 text-emerald-400 border-emerald-400/20',
  },
  accepted: {
    label: 'Accepted',
    classes: 'bg-emerald-400/10 text-emerald-400 border-emerald-400/20',
  },
  archived: {
    label: 'Archived',
    classes: 'bg-zinc-400/10 text-zinc-400 border-zinc-400/20',
  },
  deprecated: {
    label: 'Deprecated',
    classes: 'bg-zinc-400/10 text-zinc-400 border-zinc-400/20',
  },
  featured: {
    label: 'Featured',
    classes: 'bg-brand-gradient text-white border-brand-400 shadow-[0_0_15px_rgba(14,165,233,0.3)]',
  },
  superseded: {
    label: 'Superseded',
    classes: 'bg-violet-400/10 text-violet-400 border-violet-400/20',
  },
};

const config = statusConfigs[status] || statusConfigs.draft;
---

<span
  class:list={[
    'inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium border uppercase tracking-wider transition-colors duration-300',
    config.classes,
    className
  ]}
>
  {config.label}
</span>
