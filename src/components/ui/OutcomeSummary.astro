---
interface Props {
  summary: string;
  compact?: boolean;
  class?: string;
}

const { summary, compact = false, class: className } = Astro.props;
---

<div
  class:list={[
    'relative overflow-hidden border-l-4 border-brand-500 bg-brand-500/5',
    compact ? 'p-4 rounded-r-xl' : 'p-6 sm:p-8 rounded-r-2xl',
    className
  ]}
>
  <div class="relative z-10">
    {!compact && (
      <span class="block text-xs font-bold text-brand-500 uppercase tracking-[0.2em] mb-3 font-mono">
        Outcome
      </span>
    )}
    <p class:list={[
      'text-zinc-200 leading-relaxed font-sans',
      compact ? 'text-sm' : 'text-lg sm:text-xl font-medium italic'
    ]}>
      {summary}
    </p>
  </div>
  
  {/* Subtle decorative element */}
  <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-32 h-32 bg-brand-500/10 blur-3xl rounded-full"></div>
</div>
