---
// Forward arbitrary attributes (id, data-*, aria-*, role...) to the rendered
// element. Without this, `<GlassPanel id="x">` silently dropped the id, which
// broke anchor links pointing at a panel.
const { class: className, ...rest } = Astro.props;
---

<div class:list={['glass-panel rounded-3xl', className]} {...rest}>
  <slot />
</div>
