---
import GlassPanel from './GlassPanel.astro';
import StatusBadge from './StatusBadge.astro';

interface Alternative {
  option: string;
  pros?: string[];
  cons?: string[];
}

interface Props {
  title: string;
  context: string;
  decision: string;
  reasoning?: string;
  alternatives?: Alternative[];
  status?: 'proposed' | 'accepted' | 'deprecated' | 'superseded';
  class?: string;
}

const { title, context, decision, reasoning, alternatives, status, class: className } = Astro.props;
---

<GlassPanel class:list={['p-5 sm:p-7 flex flex-col gap-6', className]}>
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
    <div class="flex flex-col gap-1">
      <h3 class="text-xl font-bold text-white font-sans tracking-tight">{title}</h3>
      <p class="text-xs text-zinc-500 font-mono">ADR Decision Record</p>
    </div>
    {status && <StatusBadge status={status} />}
  </div>

  <div class="grid gap-6">
    <section>
      <h4 class="text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2 font-mono">Context</h4>
      <p class="text-sm text-zinc-300 leading-relaxed">{context}</p>
    </section>

    <section class="bg-brand-500/5 border border-brand-500/10 rounded-xl p-4">
      <h4 class="text-xs font-bold text-brand-500 uppercase tracking-widest mb-2 font-mono">Decision</h4>
      <p class="text-sm font-semibold text-white leading-relaxed">{decision}</p>
    </section>

    {reasoning && (
      <section>
        <h4 class="text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2 font-mono">Reasoning</h4>
        <p class="text-sm text-zinc-300 leading-relaxed">{reasoning}</p>
      </section>
    )}

    {alternatives && alternatives.length > 0 && (
      <details class="group">
        <summary class="flex items-center justify-between cursor-pointer list-none text-xs font-bold text-zinc-500 uppercase tracking-widest hover:text-zinc-300 transition-colors font-mono">
          <span>Alternatives Considered</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="mt-4 flex flex-col gap-4 border-l border-zinc-800 ml-1 pl-4 py-1">
          {alternatives.map((alt) => (
            <div class="flex flex-col gap-2">
              <span class="text-sm font-medium text-zinc-200">{alt.option}</span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {alt.pros && (
                  <div>
                    <span class="text-[10px] font-bold text-emerald-500/70 uppercase mb-1 block">Pros</span>
                    <ul class="text-[11px] text-zinc-400 list-disc list-inside">
                      {alt.pros.map(pro => <li>{pro}</li>)}
                    </ul>
                  </div>
                )}
                {alt.cons && (
                  <div>
                    <span class="text-[10px] font-bold text-rose-500/70 uppercase mb-1 block">Cons</span>
                    <ul class="text-[11px] text-zinc-400 list-disc list-inside">
                      {alt.cons.map(con => <li>{con}</li>)}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </details>
    )}
  </div>
</GlassPanel>
