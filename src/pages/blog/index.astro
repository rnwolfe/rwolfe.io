---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import GlassPanel from '../../components/ui/GlassPanel.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog | Ryan Wolfe">
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-2">Blog</h1>
    <p class="text-gray-600 dark:text-gray-400">Thoughts on development, design, and the web.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {posts.map((post, index) => (
      <a href={`/blog/${post.id}/`} class={index === 0 ? 'md:col-span-2' : ''}>
        <GlassPanel class="overflow-hidden group h-full">
          {post.data.heroImage && (
            <div class="h-48 md:h-64 overflow-hidden">
              <Image
                width={720}
                height={360}
                src={post.data.heroImage}
                alt=""
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
          )}
          <div class="p-6">
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
              <FormattedDate date={post.data.pubDate} />
            </p>
            <h2 class={`font-bold mb-2 group-hover:text-brand-500 transition-colors ${index === 0 ? 'text-2xl md:text-3xl' : 'text-xl'}`}>
              {post.data.title}
            </h2>
            {post.data.description && (
              <p class="text-gray-600 dark:text-gray-300 line-clamp-2">
                {post.data.description}
              </p>
            )}
          </div>
        </GlassPanel>
      </a>
    ))}
  </div>
</Layout>
