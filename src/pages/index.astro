---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GlassPanel from '../components/ui/GlassPanel.astro';

// Get the latest project
const projects = await getCollection('projects');
projects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestProject = projects[0];

// Calculate days since publication
const daysSince = latestProject
  ? Math.floor((Date.now() - latestProject.data.pubDate.valueOf()) / (1000 * 60 * 60 * 24))
  : 0;
const timeAgo =
  daysSince === 0
    ? 'Today'
    : daysSince === 1
      ? 'Yesterday'
      : daysSince < 7
        ? `${daysSince} days ago`
        : daysSince < 30
          ? `${Math.floor(daysSince / 7)} weeks ago`
          : `${Math.floor(daysSince / 30)} months ago`;
---

<Layout title="Ryan Wolfe | Creative Developer">
  <!-- Background Gradients -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div
      class="absolute top-0 left-1/4 w-96 h-96 bg-brand-500/20 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob dark:bg-brand-500/10"
    >
    </div>
    <div
      class="absolute top-0 right-1/4 w-96 h-96 bg-purple-500/20 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob dark:bg-purple-500/10"
      style="animation-delay: 2s"
    >
    </div>
    <div
      class="absolute -bottom-32 left-1/3 w-96 h-96 bg-pink-500/20 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob dark:bg-pink-500/10"
      style="animation-delay: 4s"
    >
    </div>
  </div>

  <div class="bento-grid">
    <!-- 1. Introduction Card (Large) -->
    <GlassPanel
      class="md:col-span-2 h-min p-8 flex flex-col group hover:border-brand-500/30 transition-all duration-300"
    >
      <div>
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-100 dark:bg-brand-900/30 text-brand-600 dark:text-brand-400 text-xs font-semibold mb-6"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
          </span>
          Open to Work
        </div>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-4">
          Crafting digital <span
            class="text-transparent bg-clip-text bg-linear-to-r from-brand-500 to-purple-600"
            >experiences</span
          > that matter.
        </h1>
        <p class="text-gray-600 dark:text-gray-400 text-lg max-w-md">
          Full-stack creative developer specializing in Astro, React, and performance-first
          architecture.
        </p>
      </div>
      <div class="flex gap-4 mt-8">
        <a
          href="/projects"
          class="px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-xl font-medium hover:opacity-90 transition-opacity flex items-center gap-2"
        >
          View Work <Icon name="lucide:arrow-right" class="w-4 h-4" />
        </a>
        <a
          href="/about"
          class="px-6 py-3 glass-panel border border-gray-200 dark:border-gray-700 rounded-xl font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
        >
          Contact Me
        </a>
      </div>
    </GlassPanel>

    <!-- 2. Profile / Avatar -->
    <GlassPanel class="md:col-span-1 p-0 relative overflow-hidden group">
      <div class="absolute inset-0">
        <img
          src="/profile.jpeg"
          alt="Profile"
          class="w-full h-full object-cover rounded-2xl transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-linear-to-b from-transparent to-black/60 rounded-2xl"></div>
      </div>
      <div class="absolute bottom-6 left-6 z-20">
        <h3 class="text-white text-xl font-bold">Ryan Wolfe</h3>
        <p class="text-gray-200 text-sm">Creative Developer</p>
      </div>
    </GlassPanel>

    <!-- 3. Tech Stack -->
    <GlassPanel
      class="md:col-span-1 md:row-span-1 p-6 flex flex-col justify-center overflow-hidden"
    >
      <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Core Stack</h3>
      <div class="flex gap-4 overflow-x-auto no-scrollbar pb-2">
        <Icon name="lucide:code-2" class="w-8 h-8 text-orange-500" />
        <Icon name="lucide:file-json" class="w-8 h-8 text-blue-500" />
        <Icon name="lucide:wind" class="w-8 h-8 text-cyan-500" />
        <Icon name="lucide:database" class="w-8 h-8 text-green-500" />
        <Icon name="lucide:figma" class="w-8 h-8 text-pink-500" />
        <Icon name="lucide:git-branch" class="w-8 h-8 text-gray-500" />
      </div>
    </GlassPanel>

    <!-- 4. Social Links -->
    <GlassPanel class="md:col-span-1 md:row-span-1 p-6 flex items-center justify-around">
      <a
        href="#"
        class="p-3 rounded-full hover:bg-brand-50 dark:hover:bg-brand-900/20 text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400 transition-all hover:-translate-y-1"
      >
        <Icon name="lucide:github" class="w-6 h-6" />
      </a>
      <a
        href="#"
        class="p-3 rounded-full hover:bg-blue-50 dark:hover:bg-blue-900/20 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-all hover:-translate-y-1"
      >
        <Icon name="lucide:twitter" class="w-6 h-6" />
      </a>
      <a
        href="#"
        class="p-3 rounded-full hover:bg-blue-50 dark:hover:bg-blue-900/20 text-gray-600 dark:text-gray-400 hover:text-blue-700 dark:hover:text-blue-400 transition-all hover:-translate-y-1"
      >
        <Icon name="lucide:linkedin" class="w-6 h-6" />
      </a>
      <a
        href="#"
        class="p-3 rounded-full hover:bg-red-50 dark:hover:bg-red-900/20 text-gray-600 dark:text-gray-400 hover:text-red-600 dark:hover:text-red-400 transition-all hover:-translate-y-1"
      >
        <Icon name="lucide:mail" class="w-6 h-6" />
      </a>
    </GlassPanel>

    <!-- 5. Latest Project -->
    {latestProject ? (
      <a href={`/projects/${latestProject.id}`} class="md:col-span-1 md:row-span-1">
        <GlassPanel class="p-6 relative overflow-hidden group cursor-pointer h-full">
          <div
            class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"
          >
            <Icon name="lucide:rocket" class="w-24 h-24" />
          </div>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1">
            Latest Project
          </h3>
          <p class="text-2xl font-bold truncate">{latestProject.data.title}</p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">
            {latestProject.data.outcomeSummary}
          </p>
          <div class="mt-4 flex items-center gap-2 text-sm text-green-600 dark:text-green-400">
            <Icon name="lucide:check-circle-2" class="w-4 h-4" />
            <span>Shipped {timeAgo}</span>
          </div>
        </GlassPanel>
      </a>
    ) : (
      <a href="/projects" class="md:col-span-1 md:row-span-1">
        <GlassPanel class="p-6 relative overflow-hidden group cursor-pointer h-full">
          <div
            class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity"
          >
            <Icon name="lucide:cpu" class="w-24 h-24" />
          </div>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1">
            Latest Deploy
          </h3>
          <p class="text-2xl font-bold truncate">Coming Soon</p>
          <div class="mt-4 flex items-center gap-2 text-sm text-gray-500">
            <Icon name="lucide:clock" class="w-4 h-4" />
            <span>Projects in progress</span>
          </div>
        </GlassPanel>
      </a>
    )}
  </div>
</Layout>
