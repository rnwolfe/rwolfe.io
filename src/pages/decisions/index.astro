---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import GlassPanel from '../../components/ui/GlassPanel.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const decisions = (await getCollection('decisions')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = [...new Set(decisions.map((d) => d.data.category).filter(Boolean))];
---

<Layout title="Technical Decisions | ADR">
	<div class="max-w-6xl mx-auto py-12 space-y-12">
		<header class="space-y-4">
			<h1 class="text-4xl md:text-6xl font-bold tracking-tight text-zinc-900 dark:text-white">
				Technical Decisions
			</h1>
			<p class="text-xl text-zinc-600 dark:text-zinc-400 max-w-3xl">
				A living record of architectural decisions, tradeoffs, and technical direction. 
				Following the Architectural Decision Record (ADR) format.
			</p>
		</header>

		<div class="grid lg:grid-cols-[200px_1fr] gap-12">
			<!-- Sidebar / Filters -->
			<aside class="space-y-8 hidden lg:block">
				<div>
					<h2 class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest font-mono mb-4">Categories</h2>
					<ul class="space-y-2">
						<li>
							<a href="/decisions" class="text-sm font-medium text-brand-500">All Decisions</a>
						</li>
						{categories.map((category: any) => (
							<li>
								<a href={`#${category}`} class="text-sm font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
									{category}
								</a>
							</li>
						))}
					</ul>
				</div>
				
				<GlassPanel class="p-4 bg-brand-500/10 dark:bg-brand-500/5 border border-brand-500/20 dark:border-brand-500/10">
					<p class="text-xs text-brand-700 dark:text-brand-400 leading-relaxed">
						<strong>What is an ADR?</strong><br/>
						An Architectural Decision Record is a document that captures an important architectural decision made along with its context and consequences.
					</p>
				</GlassPanel>
			</aside>

			<!-- Decisions Timeline -->
			<div class="space-y-12">
				{decisions.map((decision: any) => (
					<div class="relative pl-8 md:pl-0">
						<!-- Timeline line for mobile -->
						<div class="absolute left-0 top-0 bottom-0 w-px bg-zinc-200 dark:bg-zinc-800 md:hidden"></div>
						
						<a href={`/decisions/${decision.id}/`} class="group block">
							<GlassPanel class="p-6 md:p-8 transition-all duration-300 group-hover:border-brand-500/50 group-hover:shadow-[0_0_30px_rgba(14,165,233,0.1)]">
								<div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
									<div class="space-y-4 flex-1">
										<div class="flex flex-wrap items-center gap-3">
											<StatusBadge status={decision.data.status} />
											<span class="text-xs text-zinc-400 dark:text-zinc-500 font-mono">
												<FormattedDate date={decision.data.pubDate} />
											</span>
											{decision.data.category && (
												<span class="px-2 py-0.5 rounded-full text-[10px] font-bold border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 uppercase tracking-wider">
													{decision.data.category}
												</span>
											)}
										</div>
										
										<div class="space-y-2">
											<h3 class="text-2xl font-bold text-zinc-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-500 transition-colors tracking-tight">
												{decision.data.title}
											</h3>
											<p class="text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed">
												{decision.data.description}
											</p>
										</div>

										<div class="flex items-center gap-4 pt-2">
											<div class="flex flex-wrap gap-2">
												{decision.data.tags.slice(0, 3).map((tag: string) => (
													<span class="text-[10px] text-zinc-400 dark:text-zinc-500 font-medium">#{tag}</span>
												))}
											</div>
										</div>
									</div>
									
									<div class="flex-shrink-0 self-end md:self-start">
										<div class="w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 flex items-center justify-center group-hover:bg-brand-500 group-hover:border-brand-500 group-hover:text-white transition-all duration-300">
											<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
										</div>
									</div>
								</div>
							</GlassPanel>
						</a>
					</div>
				))}
			</div>
		</div>
	</div>
</Layout>
