---
import { getCollection, render, getEntries } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TimelineEntry from '../components/ui/TimelineEntry.astro';
import GlassPanel from '../components/ui/GlassPanel.astro';

const journeyEntries = await getCollection('journey');
const sortedEntries = journeyEntries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Process entries to include rendered content and resolved projects
const processedEntries = await Promise.all(
  sortedEntries.map(async (entry) => {
    const { Content } = await render(entry);
    const relatedProjects = entry.data.relatedProjects 
      ? await getEntries(entry.data.relatedProjects) 
      : [];
    return { ...entry, Content, resolvedProjects: relatedProjects };
  })
);

const title = "Journey | Ryan Wolfe";
const description = "A running timeline of roles, pivots, and lessons — updated occasionally.";
---

<Layout title={title} description={description}>
  <div class="relative pt-10 md:pt-20 pb-24 md:pb-32">
    {/* Background Decorative Elements */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-full -z-10 pointer-events-none">
      <div class="absolute top-[10%] left-[10%] w-64 h-64 bg-brand-500/10 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[20%] right-[10%] w-96 h-96 bg-violet-500/10 rounded-full blur-[150px]"></div>
    </div>

    <div class="max-w-4xl mx-auto px-6">
      {/* Header Section */}
      <header class="mb-24 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-600 dark:text-brand-400 text-xs font-bold tracking-widest uppercase">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
          </span>
          Evolution
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-zinc-900 dark:text-white font-sans">
          The <span class="text-transparent bg-clip-text bg-linear-to-r from-brand-600 dark:from-brand-400 to-violet-600 dark:to-violet-400">Journey</span> So Far
        </h1>
        
        <p class="text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
          {description}
        </p>
      </header>

      {/* Timeline Section */}
      {processedEntries.length > 0 ? (
        <div class="relative space-y-4">
          {processedEntries.map(({ data, Content, resolvedProjects }) => (
            <TimelineEntry
              date={data.date}
              endDate={data.endDate}
              title={data.title}
              entryType={data.entryType}
              highlights={data.highlights}
              company={data.company}
              role={data.role}
              location={data.location}
              tech={data.tech}
              relatedProjects={resolvedProjects}
            >
              <Content />
            </TimelineEntry>
          ))}
        </div>
      ) : (
        <GlassPanel class="p-8 md:p-10 border-zinc-200 dark:border-white/5 bg-zinc-50/50 dark:bg-white/2 backdrop-blur-md">
          <h2 class="text-xl font-bold mb-2 text-zinc-900 dark:text-white">No entries yet</h2>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            I’m rebuilding this site around writing first. I’ll add the journey timeline back as I curate it.
            For now, <a class="text-brand-600 dark:text-brand-400 hover:underline" href="/start">Start here</a> is the best entry point.
          </p>
        </GlassPanel>
      )
    </div>
  </div>
</Layout>

<style>
  /* Custom scrollbar for the page to match the vibe */
  :root {
    scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
    scrollbar-width: thin;
  }
  
  ::-webkit-scrollbar {
    width: 6px;
  }
  
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  
  ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.1);
  }
</style>
