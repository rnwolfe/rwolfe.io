---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import GlassPanel from '../../components/ui/GlassPanel.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import TechStack from '../../components/ui/TechStack.astro';
import OutcomeSummary from '../../components/ui/OutcomeSummary.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { Image } from 'astro:assets';

const allProjects = await getCollection('projects');

// Sort by date descending
const projects = allProjects.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredProjects = projects.filter(p => p.data.status === 'featured');
const otherProjects = projects.filter(p => p.data.status !== 'featured');
---

<Layout title="Projects | Case Studies">
  <div class="max-w-7xl mx-auto flex flex-col gap-12">
    {/* Header */}
    <header class="flex flex-col gap-4 max-w-3xl">
      <h1 class="text-4xl md:text-6xl font-bold font-sans tracking-tight text-zinc-900 dark:text-white">
        Selected <span class="text-gradient">Works</span>
      </h1>
      <p class="text-xl text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
        A collection of case studies focusing on performance, architecture, and measurable impact.
      </p>
    </header>

    {/* Featured Section */}
    {featuredProjects.length > 0 && (
      <section class="flex flex-col gap-6">
        <div class="flex items-center gap-4">
          <h2 class="text-xs font-bold text-brand-500 uppercase tracking-[0.2em] font-mono">
            Featured Projects
          </h2>
          <div class="h-px flex-1 bg-brand-500/20"></div>
        </div>
        
        <div class="grid grid-cols-1 gap-8">
          {featuredProjects.map((project) => (
            <a href={`/projects/${project.id}`} class="group">
              <GlassPanel class="grid grid-cols-1 md:grid-cols-12 gap-0 overflow-hidden group-hover:border-brand-500/40 transition-all duration-500 group-hover:shadow-[0_0_30px_rgba(14,165,233,0.1)]">
                {/* Image side */}
                <div class="md:col-span-5 h-64 md:h-auto relative overflow-hidden">
                  {project.data.heroImage ? (
                    <Image 
                      src={project.data.heroImage} 
                      alt={project.data.title}
                      width={800}
                      height={600}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <div class="w-full h-full bg-zinc-900 flex items-center justify-center">
                      <span class="text-zinc-700 font-mono">No Image</span>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent md:hidden"></div>
                </div>

                {/* Content side */}
                <div class="md:col-span-7 p-6 md:p-10 flex flex-col gap-6">
                  <div class="flex flex-wrap items-center justify-between gap-4">
                    <StatusBadge status={project.data.status} />
                    <span class="text-xs text-zinc-400 dark:text-zinc-500 font-mono">
                      <FormattedDate date={project.data.pubDate} />
                    </span>
                  </div>

                  <div class="flex flex-col gap-2">
                    <h3 class="text-2xl md:text-3xl font-bold text-zinc-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                      {project.data.title}
                    </h3>
                    <p class="text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed">
                      {project.data.description}
                    </p>
                  </div>

                  <OutcomeSummary summary={project.data.outcomeSummary} compact />

                  <div class="flex flex-wrap items-center justify-between gap-4 mt-auto">
                    <TechStack tech={project.data.tech} limit={4} />
                    <span class="text-sm font-bold text-zinc-900 dark:text-white flex items-center gap-2 group-hover:gap-3 transition-all">
                      Read Case Study <span class="text-brand-600 dark:text-brand-500">→</span>
                    </span>
                  </div>
                </div>
              </GlassPanel>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* All Projects Grid */}
    {otherProjects.length > 0 && (
      <section class="flex flex-col gap-6">
        <div class="flex items-center gap-4">
          <h2 class="text-xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.2em] font-mono">
            Archive & More
          </h2>
          <div class="h-px flex-1 bg-zinc-200 dark:bg-white/10"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {otherProjects.map((project) => (
            <a href={`/projects/${project.id}`} class="group">
              <GlassPanel class="flex flex-col h-full p-6 gap-6 group-hover:border-zinc-300 dark:group-hover:border-white/20 transition-all duration-300">
                <div class="flex items-center justify-between gap-2">
                  <StatusBadge status={project.data.status} />
                  <span class="text-[10px] text-zinc-400 dark:text-zinc-500 font-mono">
                    <FormattedDate date={project.data.pubDate} />
                  </span>
                </div>

                <div class="flex flex-col gap-2">
                  <h3 class="text-xl font-bold text-zinc-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                    {project.data.title}
                  </h3>
                  <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-3 leading-relaxed">
                    {project.data.description}
                  </p>
                </div>

                <div class="mt-auto flex flex-col gap-4">
                  <OutcomeSummary summary={project.data.outcomeSummary} compact />
                  <TechStack tech={project.data.tech} limit={3} />
                </div>
              </GlassPanel>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
