---
import Layout from '../../layouts/Layout.astro';
import GlassPanel from '../../components/ui/GlassPanel.astro';
import { getCollection, render } from 'astro:content';

const notes = await getCollection('notes');
notes.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const renderedNotes = await Promise.all(
  notes.map(async (note) => {
    const { Content } = await render(note);
    return { ...note, Content };
  }),
);

const typeColors: Record<string, string> = {
  thought: 'text-blue-500 dark:text-blue-400',
  quote: 'text-purple-500 dark:text-purple-400',
  til: 'text-emerald-500 dark:text-emerald-400',
  bookmark: 'text-amber-500 dark:text-amber-400',
  question: 'text-rose-500 dark:text-rose-400',
};

const typeLabels: Record<string, string> = {
  thought: 'Thought',
  quote: 'Quote',
  til: 'TIL',
  bookmark: 'Bookmark',
  question: 'Question',
};
---

<Layout title="Notes & Meditations">
  <div class="max-w-6xl mx-auto py-12">
    <header class="mb-16">
      <div
        class="inline-block px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold font-mono uppercase tracking-widest mb-4"
      >
        Commonplace Book
      </div>
      <h1 class="text-4xl md:text-6xl font-bold font-mono text-gradient mb-6">
        Notes & Meditations
      </h1>
      <p class="text-zinc-600 dark:text-zinc-400 text-lg md:text-xl max-w-2xl leading-relaxed">
        A stream of consciousness, fragments of ideas, and things I've learned along the way. Dense,
        scannable, and perpetually growing.
      </p>
    </header>

    <div class="columns-1 md:columns-2 lg:columns-3 gap-8 space-y-8">
      {
        renderedNotes.map((note) => (
          <a href={`/notes/${note.id}`} class="break-inside-avoid mb-8 block">
            <GlassPanel class="p-6 h-full flex flex-col group hover:border-brand-500/30 transition-all duration-500 cursor-pointer">
              <div class="flex items-center justify-between mb-6">
                <span
                  class={`text-[10px] font-bold uppercase tracking-[0.2em] font-mono ${typeColors[note.data.type]}`}
                >
                  {typeLabels[note.data.type]}
                </span>
                <time
                  datetime={note.data.pubDate.toISOString()}
                  class="text-[10px] text-zinc-400 dark:text-zinc-500 font-mono"
                >
                  {note.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </div>

              {note.data.type === 'quote' && (
                <div class="relative py-4">
                  <span class="absolute -top-4 -left-2 text-7xl text-purple-500/10 font-serif pointer-events-none group-hover:text-purple-500/20 transition-colors">
                    "
                  </span>
                  <blockquote class="text-xl md:text-2xl font-medium italic mb-6 leading-relaxed relative z-10 text-zinc-800 dark:text-zinc-200">
                    <note.Content />
                  </blockquote>
                  {note.data.source && (
                    <cite class="block text-sm text-zinc-500 dark:text-zinc-400 not-italic border-l-2 border-purple-500/30 pl-4 py-1">
                      {note.data.sourceUrl ? (
                        <a
                          href={note.data.sourceUrl}
                          class="hover:text-purple-500 transition-colors"
                          target="_blank"
                          rel="noopener noreferrer"
                          onclick="event.stopPropagation()"
                        >
                          {note.data.source}
                        </a>
                      ) : (
                        note.data.source
                      )}
                    </cite>
                  )}
                </div>
              )}

              {note.data.type === 'thought' && (
                <div class="flex flex-col">
                  <h3 class="text-xl font-bold mb-4 leading-tight group-hover:text-blue-600 dark:group-hover:text-blue-500 transition-colors duration-300">
                    {note.data.title}
                  </h3>
                  <div class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed prose-sm prose-p:my-2 prose-strong:text-blue-600 dark:prose-strong:text-blue-500/80">
                    <note.Content />
                  </div>
                </div>
              )}

              {note.data.type === 'til' && (
                <div>
                  <div class="inline-flex items-center gap-2 mb-4 bg-emerald-500/10 dark:bg-emerald-500/5 px-2 py-1 rounded text-[10px] font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-widest border border-emerald-500/20 dark:border-emerald-500/10">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" />
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500" />
                    </span>
                    TIL
                  </div>
                  <h3 class="text-lg font-bold mb-3 leading-snug group-hover:text-emerald-600 dark:group-hover:text-emerald-500 transition-colors">
                    {note.data.title}
                  </h3>
                  <div class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed italic border-l-2 border-emerald-500/20 pl-4">
                    <note.Content />
                  </div>
                </div>
              )}

              {note.data.type === 'bookmark' && (
                <div class="flex flex-col h-full">
                  <h3 class="text-lg font-bold mb-3 leading-snug group-hover:text-amber-600 dark:group-hover:text-amber-500 transition-colors">
                    {note.data.title}
                  </h3>
                  <div class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mb-4">
                    <note.Content />
                  </div>
                  {note.data.sourceUrl && (
                    <div class="mt-auto pt-4 overflow-hidden flex items-center justify-between">
                      <div class="text-[10px] font-mono text-zinc-400 truncate">
                        {new URL(note.data.sourceUrl).hostname}
                      </div>
                      <a
                        href={note.data.sourceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="external-link text-[10px] font-medium text-amber-600 dark:text-amber-500 hover:text-amber-500 dark:hover:text-amber-400 flex items-center gap-1"
                        onclick="event.stopPropagation()"
                      >
                        Visit
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                          <polyline points="15 3 21 3 21 9" />
                          <line x1="10" y1="14" x2="21" y2="3" />
                        </svg>
                      </a>
                    </div>
                  )}
                </div>
              )}

              {note.data.type === 'question' && (
                <div class="bg-rose-500/10 dark:bg-rose-500/5 -mx-6 mb-6 p-6 mt-6 border-t border-rose-500/20 dark:border-rose-500/10 group-hover:bg-rose-500/15 dark:group-hover:bg-rose-500/8 transition-colors">
                  <div class="flex items-start gap-4">
                    <div class="shrink-0 w-8 h-8 rounded-full bg-rose-500/10 flex items-center justify-center text-rose-600 dark:text-rose-500 font-bold font-mono">
                      ?
                    </div>
                    <div class="flex-1">
                      <h3 class="text-lg font-bold mb-2 text-zinc-900 dark:text-zinc-100">
                        {note.data.title}
                      </h3>
                      <div class="text-zinc-600 dark:text-zinc-400 text-sm italic leading-relaxed mb-4">
                        <note.Content />
                      </div>
                      <a
                        href={`https://claude.ai/new?q=${encodeURIComponent(note.data.title)}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-xs font-medium text-rose-600 dark:text-rose-500 hover:text-rose-500 dark:hover:text-rose-400 transition-colors group/llm"
                        onclick="event.stopPropagation()"
                      >
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                        </svg>
                        <span>Ask an LLM</span>
                        <svg class="w-3 h-3 opacity-0 -translate-x-1 group-hover/llm:opacity-100 group-hover/llm:translate-x-0 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>
              )}

              <div class="mt-auto pt-6 flex flex-wrap gap-2">
                {note.data.tags.map((tag) => (
                  <span class="text-[9px] font-bold font-mono bg-zinc-100 dark:bg-white/5 text-zinc-400 dark:text-zinc-500 px-2 py-0.5 rounded uppercase tracking-wider hover:text-brand-600 dark:hover:text-brand-500 hover:bg-brand-500/10 dark:hover:bg-brand-500/5 transition-colors cursor-default">
                    {tag}
                  </span>
                ))}
              </div>
            </GlassPanel>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  /* Masonry columns tweak */
  @media (min-width: 768px) {
    .columns-2 {
      column-count: 2;
    }
  }
  @media (min-width: 1024px) {
    .columns-3 {
      column-count: 3;
    }
  }
</style>
