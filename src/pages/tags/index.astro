---
import Layout from '../../layouts/Layout.astro';
import GlassPanel from '../../components/ui/GlassPanel.astro';
import { getCollection } from 'astro:content';

// Gather all tags from all collections that have them
const blog = await getCollection('blog');
const notes = await getCollection('notes');
const projects = await getCollection('projects');

// Build tag counts
const tagCounts = new Map<string, { count: number; collections: Set<string> }>();

const addTags = (items: any[], collectionName: string, tagField: string = 'tags') => {
  items.forEach((item) => {
    const tags = item.data[tagField] || [];
    tags.forEach((tag: string) => {
      const existing = tagCounts.get(tag) || { count: 0, collections: new Set() };
      existing.count++;
      existing.collections.add(collectionName);
      tagCounts.set(tag, existing);
    });
  });
};

// Also add tech as tags for projects
const addTech = (items: any[], collectionName: string) => {
  items.forEach((item) => {
    const tech = item.data.tech || [];
    tech.forEach((t: string) => {
      const existing = tagCounts.get(t) || { count: 0, collections: new Set() };
      existing.count++;
      existing.collections.add(collectionName);
      tagCounts.set(t, existing);
    });
  });
};

addTags(blog, 'blog');
addTags(notes, 'notes');
addTech(projects, 'projects');

// Sort by count descending
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1].count - a[1].count);

// Group by first letter
const groupedTags = sortedTags.reduce(
  (acc, [tag, data]) => {
    const letter = tag[0].toUpperCase();
    if (!acc[letter]) acc[letter] = [];
    acc[letter].push({ tag, ...data });
    return acc;
  },
  {} as Record<string, { tag: string; count: number; collections: Set<string> }[]>,
);

const letters = Object.keys(groupedTags).sort();
---

<Layout title="Tags">
  <div class="max-w-4xl mx-auto py-12">
    <header class="mb-16">
      <div
        class="inline-block px-3 py-1 rounded-full bg-brand-500/10 text-brand-500 text-xs font-bold font-mono uppercase tracking-widest mb-4"
      >
        Browse by Topic
      </div>
      <h1 class="text-4xl md:text-6xl font-bold font-mono mb-6 text-zinc-900 dark:text-white">
        Tags
      </h1>
      <p class="text-zinc-500 dark:text-zinc-400 text-lg max-w-2xl">
        Explore content across all collections by topic. Tags are gathered from blog posts, notes,
        and project tech stacks.
      </p>
    </header>

    <!-- Tag Cloud -->
    <GlassPanel class="p-8 mb-12">
      <div class="flex flex-wrap gap-3">
        {
          sortedTags.slice(0, 30).map(([tag, data]) => {
            const size =
              data.count >= 5 ? 'text-lg' : data.count >= 3 ? 'text-base' : 'text-sm';
            return (
              <a
                href={`/tags/${tag.toLowerCase()}`}
                class={`${size} px-3 py-1.5 rounded-lg bg-zinc-100 dark:bg-white/5 text-zinc-600 dark:text-zinc-300 hover:bg-brand-500/10 hover:text-brand-500 transition-colors font-medium`}
              >
                {tag}
                <span class="ml-1 text-xs text-zinc-400 dark:text-zinc-500">({data.count})</span>
              </a>
            );
          })
        }
      </div>
    </GlassPanel>

    <!-- Alphabetical Index -->
    <div class="space-y-8">
      {
        letters.map((letter) => (
          <div>
            <h2 class="text-2xl font-bold font-mono text-zinc-300 dark:text-zinc-600 mb-4">
              {letter}
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
              {groupedTags[letter].map(({ tag, count }) => (
                <a
                  href={`/tags/${tag.toLowerCase()}`}
                  class="group flex items-center justify-between p-3 rounded-lg bg-zinc-50 dark:bg-white/5 hover:bg-brand-500/10 transition-colors"
                >
                  <span class="text-zinc-700 dark:text-zinc-300 group-hover:text-brand-500 transition-colors truncate">
                    {tag}
                  </span>
                  <span class="text-xs text-zinc-400 dark:text-zinc-500 ml-2 shrink-0">
                    {count}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
