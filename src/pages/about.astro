---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import GlassPanel from '../components/ui/GlassPanel.astro';
---

<Layout title="About | Ryan Wolfe">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <GlassPanel class="md:col-span-2 p-8">
      <h1 class="text-4xl font-bold mb-6">About Me</h1>
      <div class="prose dark:prose-invert max-w-none">
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-4">
          I'm Ryan, a creative developer obsessed with performance and interaction design. I believe the web should be fast, accessible, and delightful.
        </p>
        <p class="text-gray-600 dark:text-gray-300 mb-4">
          My journey started with exploring the View Source of Geocities sites, and now I'm building scalable applications using the bleeding edge of the JavaScript ecosystem.
        </p>
        <p class="text-gray-600 dark:text-gray-300">
          When I'm not coding, you can find me hiking, making coffee, or tinkering with home automation.
        </p>
      </div>
    </GlassPanel>

    <GlassPanel class="p-8 flex flex-col justify-center items-center text-center">
      <div class="w-32 h-32 bg-gray-200 dark:bg-gray-800 rounded-full mb-6 overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80"
          alt="Profile"
          class="w-full h-full object-cover"
        />
      </div>
      <h3 class="text-xl font-bold mb-1">Let's Connect</h3>
      <p class="text-gray-500 text-sm mb-6">Open for freelance opportunities.</p>
      <button class="w-full py-3 bg-brand-600 hover:bg-brand-700 text-white rounded-xl font-medium transition-colors flex items-center justify-center gap-2">
        <Icon name="lucide:mail" class="w-4 h-4" />
        Copy Email
      </button>
    </GlassPanel>
  </div>

  <GlassPanel class="mt-6 p-8">
    <h2 class="text-2xl font-bold mb-8">Technical Arsenal</h2>
    
    <div class="space-y-8">
      <div>
        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Frontend</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="p-4 bg-gray-50 dark:bg-white/5 rounded-xl border border-gray-200 dark:border-white/10 flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-orange-500"></div> Astro 5
          </div>
          <div class="p-4 bg-gray-50 dark:bg-white/5 rounded-xl border border-gray-200 dark:border-white/10 flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-blue-500"></div> React
          </div>
          <div class="p-4 bg-gray-50 dark:bg-white/5 rounded-xl border border-gray-200 dark:border-white/10 flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-blue-400"></div> TypeScript
          </div>
          <div class="p-4 bg-gray-50 dark:bg-white/5 rounded-xl border border-gray-200 dark:border-white/10 flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-cyan-400"></div> Tailwind
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Backend & Tools</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="p-4 bg-gray-50 dark:bg-white/5 rounded-xl border border-gray-200 dark:border-white/10 flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-green-500"></div> Node.js
          </div>
          <div class="p-4 bg-gray-50 dark:bg-white/5 rounded-xl border border-gray-200 dark:border-white/10 flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-yellow-500"></div> Firebase
          </div>
          <div class="p-4 bg-gray-50 dark:bg-white/5 rounded-xl border border-gray-200 dark:border-white/10 flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-white dark:bg-gray-400"></div> Next.js
          </div>
          <div class="p-4 bg-gray-50 dark:bg-white/5 rounded-xl border border-gray-200 dark:border-white/10 flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-purple-500"></div> Vite
          </div>
        </div>
      </div>
    </div>
  </GlassPanel>
</Layout>
