---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import GlassPanel from '../components/ui/GlassPanel.astro';
import OutcomeSummary from '../components/ui/OutcomeSummary.astro';
import MetricGrid from '../components/ui/MetricGrid.astro';
import TechStack from '../components/ui/TechStack.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Metric {
  label: string;
  value: string;
  change?: string;
}

interface Props {
  title: string;
  description: string;
  outcomeSummary: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: any;
  status: 'draft' | 'ongoing' | 'completed' | 'archived' | 'featured';
  role?: string;
  company?: string;
  duration?: string;
  teamSize?: string;
  tech: string[];
  metrics: Metric[];
}

const {
  title,
  description,
  outcomeSummary,
  pubDate,
  updatedDate,
  heroImage,
  status,
  role,
  company,
  duration,
  teamSize,
  tech,
  metrics = [],
} = Astro.props;
---

<Layout title={title}>
  <article class="max-w-5xl mx-auto flex flex-col gap-8">
    {/* Hero Section */}
    <div class="flex flex-col gap-6">
      <div class="flex flex-wrap items-center gap-3">
        <StatusBadge status={status} />
        <span class="text-sm text-zinc-500 font-mono">
          <FormattedDate date={pubDate} />
        </span>
      </div>

      <div class="flex flex-col gap-4">
        <h1 class="text-4xl md:text-6xl font-bold font-sans tracking-tight text-white">
          {title}
        </h1>
        <p class="text-xl md:text-2xl text-zinc-400 font-sans leading-relaxed max-w-3xl">
          {description}
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 py-6 border-y border-white/10">
        {role && (
          <div class="flex flex-col">
            <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-1 font-mono">Role</span>
            <span class="text-zinc-200 font-medium">{role}</span>
          </div>
        )}
        {company && (
          <div class="flex flex-col">
            <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-1 font-mono">Company</span>
            <span class="text-zinc-200 font-medium">{company}</span>
          </div>
        )}
        {duration && (
          <div class="flex flex-col">
            <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-1 font-mono">Duration</span>
            <span class="text-zinc-200 font-medium">{duration}</span>
          </div>
        )}
        {teamSize && (
          <div class="flex flex-col">
            <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-1 font-mono">Team</span>
            <span class="text-zinc-200 font-medium">{teamSize}</span>
          </div>
        )}
      </div>
    </div>

    {/* Hero Image */}
    {heroImage && (
      <GlassPanel class="overflow-hidden border-white/10">
        <Image
          width={1200}
          height={600}
          src={heroImage}
          alt={title}
          class="w-full h-auto object-cover"
        />
      </GlassPanel>
    )}

    {/* Outcome & Metrics */}
    <div class="grid gap-6">
      <OutcomeSummary summary={outcomeSummary} />
      {metrics && metrics.length > 0 && <MetricGrid metrics={metrics} />}
    </div>

    {/* Content Area */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mt-8">
      {/* Main Content */}
      <div class="lg:col-span-8">
        <GlassPanel class="p-8 md:p-12">
          <div class="prose prose-lg dark:prose-invert max-w-none 
            prose-headings:font-bold prose-headings:tracking-tight
            prose-a:text-brand-400 hover:prose-a:text-brand-300
            prose-strong:text-white
            prose-code:text-brand-300
            prose-pre:bg-zinc-900/50 prose-pre:border prose-pre:border-white/10">
            <slot />
          </div>
        </GlassPanel>
      </div>

      {/* Sidebar */}
      <aside class="lg:col-span-4 flex flex-col gap-8">
        <section class="flex flex-col gap-4">
          <h3 class="text-xs font-bold text-zinc-500 uppercase tracking-widest font-mono">
            Tech Stack
          </h3>
          <TechStack tech={tech} size="md" />
        </section>

        {updatedDate && (
          <div class="text-xs text-zinc-500 font-mono italic">
            Last updated: <FormattedDate date={updatedDate} />
          </div>
        )}
      </aside>
    </div>
  </article>
</Layout>
