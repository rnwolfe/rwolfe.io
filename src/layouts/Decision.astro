---
import { type CollectionEntry, getEntries } from 'astro:content';
import Layout from './Layout.astro';
import GlassPanel from '../components/ui/GlassPanel.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'decisions'>['data'];

const {
  title,
  description,
  pubDate,
  updatedDate,
  status,
  context,
  decision,
  reasoning,
  alternatives,
  consequences,
  category,
  tags,
  relatedProjects,
} = Astro.props;

const resolvedProjects = relatedProjects && relatedProjects.length > 0 
  ? await getEntries(relatedProjects) 
  : [];
---

<Layout title={`${title} | Technical Decisions`} description={description}>
  <article class="max-w-4xl mx-auto space-y-12 py-12">
    <!-- Header -->
    <header class="space-y-6">
      <div class="flex flex-wrap items-center gap-3">
        <StatusBadge status={status} />
        {category && (
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 uppercase tracking-wider">
            {category}
          </span>
        )}
        <div class="text-xs text-zinc-500 font-mono">
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <span class="ml-2">
              (Updated: <FormattedDate date={updatedDate} />)
            </span>
          )}
        </div>
      </div>
      
      <div class="space-y-4">
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-zinc-900 dark:text-white leading-[1.1]">
          {title}
        </h1>
        <p class="text-xl text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-3xl">
          {description}
        </p>
      </div>
    </header>

    <!-- ADR Content -->
    <div class="grid gap-8">
      <!-- Context & Decision Row -->
      <div class="grid md:grid-cols-2 gap-6">
        <GlassPanel class="p-8 space-y-4 border-t-2 border-t-zinc-400 dark:border-t-zinc-700">
          <h2 class="text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em] font-mono">01. Context</h2>
          <p class="text-zinc-700 dark:text-zinc-300 leading-relaxed">{context}</p>
        </GlassPanel>

        <GlassPanel class="p-8 space-y-4 border-t-2 border-t-brand-500 bg-brand-500/[0.03] dark:bg-brand-500/[0.02]">
          <h2 class="text-[10px] font-bold text-brand-500 uppercase tracking-[0.2em] font-mono">02. Decision</h2>
          <p class="text-zinc-900 dark:text-zinc-100 font-medium leading-relaxed">{decision}</p>
        </GlassPanel>
      </div>

      <!-- Reasoning -->
      {reasoning && (
        <GlassPanel class="p-8 space-y-4">
          <h2 class="text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em] font-mono">03. Reasoning</h2>
          <p class="text-zinc-700 dark:text-zinc-300 leading-relaxed">{reasoning}</p>
        </GlassPanel>
      )}

      <!-- Alternatives Table/Cards -->
      {alternatives && alternatives.length > 0 && (
        <div class="space-y-4">
          <h2 class="text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em] font-mono px-2">04. Alternatives Considered</h2>
          <div class="grid gap-4">
            {alternatives.map((alt: any) => (
              <GlassPanel class="p-6">
                <div class="grid md:grid-cols-[1fr_2fr] gap-6">
                  <div>
                    <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 mb-2">{alt.option}</h3>
                  </div>
                  <div class="grid sm:grid-cols-2 gap-6">
                    {alt.pros.length > 0 && (
                      <div class="space-y-3">
                        <span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest flex items-center gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                          Pros
                        </span>
                        <ul class="space-y-2">
                          {alt.pros.map((pro: string) => (
                            <li class="text-sm text-zinc-600 dark:text-zinc-400 leading-snug">
                              {pro}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {alt.cons.length > 0 && (
                      <div class="space-y-3">
                        <span class="text-[10px] font-bold text-rose-600 dark:text-rose-400 uppercase tracking-widest flex items-center gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                          Cons
                        </span>
                        <ul class="space-y-2">
                          {alt.cons.map((con: string) => (
                            <li class="text-sm text-zinc-600 dark:text-zinc-400 leading-snug">
                              {con}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              </GlassPanel>
            ))}
          </div>
        </div>
      )}

      <!-- Consequences -->
      {consequences && consequences.length > 0 && (
        <GlassPanel class="p-8 space-y-6">
          <h2 class="text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em] font-mono">05. Consequences</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {consequences.map((consequence: string, i: number) => (
              <div class="flex items-start gap-4 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-500/10 text-brand-500 flex items-center justify-center text-[10px] font-bold font-mono">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
                  {consequence}
                </p>
              </div>
            ))}
          </div>
        </GlassPanel>
      )}

      <!-- Related Projects -->
      {resolvedProjects.length > 0 && (
        <div class="space-y-4">
          <h2 class="text-[10px] font-bold text-zinc-500 uppercase tracking-[0.2em] font-mono px-2">Connected Projects</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {resolvedProjects.map((project: any) => (
              <a href={`/projects/${project.id}/`} class="group">
                <GlassPanel class="p-4 flex items-center justify-between group-hover:border-brand-500/50 transition-colors">
                  <div class="space-y-1">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-brand-500 transition-colors">{project.data.title}</h3>
                    <p class="text-xs text-zinc-500 line-clamp-1">{project.data.description}</p>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 group-hover:text-brand-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </GlassPanel>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Tags footer -->
      <footer class="pt-12 border-t border-zinc-200 dark:border-zinc-800">
        <div class="flex flex-wrap gap-2">
          {tags.map((tag: string) => (
            <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-medium text-zinc-600 dark:text-zinc-400">
              #{tag}
            </span>
          ))}
        </div>
      </footer>
    </div>
  </article>
</Layout>
